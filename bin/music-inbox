#!/bin/zsh

set -euo pipefail
SCRIPT_DIR="${0:A:h}"
source "$SCRIPT_DIR/../lib/music-inbox.zsh"
source "$SCRIPT_DIR/../lib/request.zsh"
source "$SCRIPT_DIR/../lib/queue.zsh"

usage() {
  print "Usage: music-inbox <status|doctor|paths|log|validate|install-transcription>"
}

music_inbox_load_config

case "${1:-status}" in
  status)
    print "Music Inbox"
    print "Root:       $MUSIC_INBOX_ROOT"
    print "Local data: $MUSIC_INBOX_LOCAL_ROOT"
    print "Queued:     $(music_inbox_note_count "$MUSIC_INBOX_QUEUED")"
    print "Processing: $(music_inbox_note_count "$MUSIC_INBOX_PROCESSING")"
    print "Done:       $(music_inbox_note_count "$MUSIC_INBOX_DONE")"
    print "Failed:     $(music_inbox_note_count "$MUSIC_INBOX_FAILED")"
    if problem="$(music_inbox_transcription_problem 2>/dev/null)"; then
      print "Transcription: Ready ($MUSIC_INBOX_WHISPER_MODEL)"
    else
      print "Transcription: $problem"
    fi
    ;;
  doctor)
    print "Music Inbox dependency check"
    music_inbox_acceleration_summary
    for tool in yt-dlp ffmpeg ffprobe deno; do
      if path="$(music_inbox_find_tool "$tool")"; then
        print "✓ $tool: $path"
      else
        print "✗ $tool: not found"
      fi
    done
    command -v brew >/dev/null 2>&1 && print "Package manager: Homebrew ($(command -v brew))"
    command -v port >/dev/null 2>&1 && print "Package manager: MacPorts ($(command -v port))"
    if whisper_path="$(music_inbox_find_whisper 2>/dev/null)"; then
      print "✓ whisper: $whisper_path"
    else
      print "○ whisper: optional; run music-inbox install-transcription"
    fi
    print "Transcription enabled: $MUSIC_INBOX_TRANSCRIPTION_ENABLED"
    print "Transcription model: $MUSIC_INBOX_WHISPER_MODEL_PATH"
    ;;
  paths)
    print "Drafts:     $MUSIC_INBOX_DRAFTS"
    print "Queued:     $MUSIC_INBOX_QUEUED"
    print "Processing: $MUSIC_INBOX_PROCESSING"
    print "Done:       $MUSIC_INBOX_DONE"
    print "Failed:     $MUSIC_INBOX_FAILED"
    print "Local data: $MUSIC_INBOX_LOCAL_ROOT"
    print "Models:     $MUSIC_INBOX_MODEL_DIR"
    ;;
  log)
    tail -n "${2:-60}" "$MUSIC_INBOX_LOG"
    ;;
  validate)
    [[ -n "${2:-}" ]] || { print -u2 'Usage: music-inbox validate <request-note>'; exit 2; }
    if ! music_inbox_parse_request "$2"; then
      print -u2 "Invalid request: $MUSIC_INBOX_REQUEST_ERROR"
      exit 1
    fi
    if ! music_inbox_request_preflight; then
      print -u2 "Request cannot run: $MUSIC_INBOX_REQUEST_ERROR"
      exit 1
    fi
    if duplicate_message="$(music_inbox_duplicate_problem)"; then
      print -u2 "Duplicate request: $duplicate_message"
      exit 1
    fi
    print "Request is valid and ready to process."
    ;;
  install-transcription)
    exec "$SCRIPT_DIR/../install.sh" --transcription-only
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    print -u2 "Unknown command: $1"
    usage
    exit 2
    ;;
esac
