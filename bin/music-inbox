#!/bin/zsh

set -euo pipefail
SCRIPT_DIR="${0:A:h}"
source "$SCRIPT_DIR/../lib/music-inbox.zsh"
source "$SCRIPT_DIR/../lib/request.zsh"
source "$SCRIPT_DIR/../lib/queue.zsh"
source "$SCRIPT_DIR/../lib/media.zsh"
source "$SCRIPT_DIR/../lib/worker.zsh"
source "$SCRIPT_DIR/../lib/launchd.zsh"
source "$SCRIPT_DIR/../lib/ui.zsh"
source "$SCRIPT_DIR/../lib/add.zsh"

usage() {
  print "Usage: music-inbox <add|status|doctor|paths|log|validate|process|install-service|start|stop|restart|uninstall-service|install-transcription [--model <name>]>"
}

case "${1:-}" in
  help|-h|--help)
    usage
    exit 0
    ;;
esac

music_inbox_load_config

case "${1:-status}" in
  add)
    music_inbox_add_request
    ;;
  status)
    music_inbox_ui_heading 'Music Inbox status'
    music_inbox_ui_key_value 'Inbox root' "$MUSIC_INBOX_ROOT"
    music_inbox_ui_key_value 'Local data' "$MUSIC_INBOX_LOCAL_ROOT"
    music_inbox_ui_key_value 'Queued' "$(music_inbox_note_count "$MUSIC_INBOX_QUEUED")"
    music_inbox_ui_key_value 'Processing' "$(music_inbox_note_count "$MUSIC_INBOX_PROCESSING")"
    music_inbox_ui_key_value 'Done' "$(music_inbox_note_count "$MUSIC_INBOX_DONE")"
    music_inbox_ui_key_value 'Failed' "$(music_inbox_note_count "$MUSIC_INBOX_FAILED")"
    music_inbox_service_status
    if problem="$(music_inbox_transcription_problem 2>/dev/null)"; then
      music_inbox_ui_success "Transcription ready ($MUSIC_INBOX_WHISPER_MODEL)"
    else
      music_inbox_ui_warning "Transcription: $problem"
    fi
    ;;
  doctor)
    music_inbox_ui_heading 'Music Inbox dependency check'
    music_inbox_acceleration_summary
    for tool in yt-dlp ffmpeg ffprobe deno; do
      if tool_path="$(music_inbox_find_tool "$tool")"; then
        music_inbox_ui_success "$tool: $tool_path"
      else
        music_inbox_ui_error "$tool: not found"
      fi
    done
    command -v brew >/dev/null 2>&1 && music_inbox_ui_info "Package manager: Homebrew ($(command -v brew))"
    command -v port >/dev/null 2>&1 && music_inbox_ui_info "Package manager: MacPorts ($(command -v port))"
    if whisper_path="$(music_inbox_find_whisper 2>/dev/null)"; then
      music_inbox_ui_success "whisper.cpp: $whisper_path"
    elif [[ "${MUSIC_INBOX_TRANSCRIPTION_ENABLED:l}" == yes ]]; then
      music_inbox_ui_error 'whisper.cpp: required for enabled transcription; run music-inbox install-transcription'
    else
      music_inbox_ui_info 'whisper.cpp: not installed (optional; run music-inbox install-transcription)'
    fi
    music_inbox_ui_key_value 'Transcription' "$MUSIC_INBOX_TRANSCRIPTION_ENABLED"
    if model_size="$(music_inbox_human_file_size "$MUSIC_INBOX_WHISPER_MODEL_PATH")"; then
      music_inbox_ui_key_value 'Model' "$MUSIC_INBOX_WHISPER_MODEL_PATH ($model_size)"
    else
      music_inbox_ui_key_value 'Model' "$MUSIC_INBOX_WHISPER_MODEL_PATH (not downloaded)"
    fi
    if transcription_problem="$(music_inbox_transcription_problem 2>/dev/null)"; then
      music_inbox_ui_success 'Transcription: ready'
    else
      music_inbox_ui_error "Transcription: not ready - $transcription_problem"
    fi
    ;;
  paths)
    print "Drafts:     $MUSIC_INBOX_DRAFTS"
    print "Queued:     $MUSIC_INBOX_QUEUED"
    print "Processing: $MUSIC_INBOX_PROCESSING"
    print "Done:       $MUSIC_INBOX_DONE"
    print "Failed:     $MUSIC_INBOX_FAILED"
    print "Local data: $MUSIC_INBOX_LOCAL_ROOT"
    print "Models:     $MUSIC_INBOX_MODEL_DIR"
    ;;
  log)
    tail -n "${2:-60}" "$MUSIC_INBOX_LOG"
    ;;
  validate)
    [[ -n "${2:-}" ]] || { print -u2 'Usage: music-inbox validate <request-note>'; exit 2; }
    if ! music_inbox_parse_request "$2"; then
      print -u2 "Invalid request: $MUSIC_INBOX_REQUEST_ERROR"
      exit 1
    fi
    if ! music_inbox_request_preflight; then
      print -u2 "Request cannot run: $MUSIC_INBOX_REQUEST_ERROR"
      exit 1
    fi
    if duplicate_message="$(music_inbox_duplicate_problem)"; then
      print -u2 "Duplicate request: $duplicate_message"
      exit 1
    fi
    print "Request is valid and ready to process."
    ;;
  process)
    exec "$SCRIPT_DIR/music-inbox-worker"
    ;;
  install-service)
    music_inbox_install_service
    ;;
  start)
    music_inbox_start_service
    ;;
  stop)
    music_inbox_stop_service
    ;;
  restart)
    music_inbox_restart_service
    ;;
  uninstall-service)
    music_inbox_uninstall_service
    ;;
  install-transcription)
    exec "$SCRIPT_DIR/../install.sh" --transcription-only "${@:2}"
    ;;
  *)
    print -u2 "Unknown command: $1"
    usage
    exit 2
    ;;
esac
